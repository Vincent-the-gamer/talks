{
  "name": "talks",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm run picker dev",
    "build": "rimraf dist && pnpm -r run build && tsx scripts/home.ts",
    "build:talk": "pnpm run picker build",
    "export": "pnpm run picker export",
    "redirects": "tsx scripts/redirects.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "picker": "tsx scripts/picker.ts",
    "prepare": "git submodule update --init --recursive",
    "dep": "taze major -I -r",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@eslint/config-inspector": "^3.5.0",
    "@iconify/json": "^2.2.539",
    "@slidev/cli": "^53.0.0",
    "@slidev/client": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "@types/node": "^25.9.9",
    "@types/prompts": "^2.4.9",
    "@types/seedrandom": "^3.0.8",
    "eslint": "^10.12.0",
    "eslint-plugin-format": "^2.0.1",
    "execa": "^10.1.0",
    "fast-glob": "^3.3.3",
    "markdown-it-magic-link": "^0.1.4",
    "playwright-chromium": "^1.63.0",
    "pnpm": "^11.28.5",
    "prettier-plugin-slidev": "^1.0.5",
    "prompts": "^2.4.2",
    "rimraf": "^6.1.3",
    "seedrandom": "^3.0.5",
    "taze": "^21.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unocss": "^66.10.5",
    "vite": "^8.3.3",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.12"
  }
}
